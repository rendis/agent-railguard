{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:ai-harness:schema:release-verdict:v1",
  "title": "AI Harness release verification verdict v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "verdict", "toolchain", "gates", "security_audit", "release", "acceptance", "failure"],
  "properties": {
    "schema": { "const": "ai-harness/release-verdict/v1" },
    "version": { "$ref": "#/$defs/semver" },
    "verdict": { "enum": ["passed", "failed"] },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "pnpm"],
      "properties": {
        "node": { "type": "string", "minLength": 1 },
        "pnpm": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "command"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "status": { "const": "passed" },
          "command": { "type": "string", "minLength": 1 },
          "evidence_sha256": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "security_audit": { "type": ["object", "null"] },
    "release": { "type": ["object", "null"] },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install_update", "linux_installer", "real_repository_matrix"],
      "properties": {
        "install_update": { "type": ["object", "null"] },
        "linux_installer": { "type": ["object", "null"] },
        "real_repository_matrix": { "type": ["object", "null"] }
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["gate", "message"],
      "properties": {
        "gate": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
