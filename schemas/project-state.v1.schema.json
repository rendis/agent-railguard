{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:railguard:schema:project-state:v1",
  "title": "Railguard project state and transaction envelopes v1",
  "description": "Closed schemas for desired state, portable lock and plans.",
  "oneOf": [
    {
      "$ref": "#/$defs/project"
    },
    {
      "$ref": "#/$defs/lock"
    },
    {
      "$ref": "#/$defs/plan"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.:_-][a-z0-9]+)*$"
    },
    "componentRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "inputId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*(?:/\\.?[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "targets",
        "selections"
      ],
      "properties": {
        "schema": {
          "const": "railguard/project/v1"
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "selections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "$ref": "#/$defs/componentRef"
              },
              "inputs": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/inputId"
                },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "catalogIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "digest"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "adapterIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "lockedTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapter",
        "capabilities"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "adapter": {
          "$ref": "#/$defs/adapterIdentity"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      }
    },
    "inclusionCause": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from",
        "reason"
      ],
      "properties": {
        "kind": {
          "enum": [
            "includes",
            "requires"
          ]
        },
        "from": {
          "$ref": "#/$defs/componentRef"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "lockedComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "version",
        "digest",
        "direct",
        "causes"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/componentRef"
        },
        "version": {
          "$ref": "#/$defs/semver"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "direct": {
          "type": "boolean"
        },
        "causes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inclusionCause"
          }
        }
      }
    },
    "artifactPointer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "section_id"
          ],
          "properties": {
            "kind": {
              "const": "managed-section"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "section_id": {
              "$ref": "#/$defs/stableId"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "pointer"
          ],
          "properties": {
            "kind": {
              "const": "json-member"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "pointer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "lockedDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownership_id",
        "path",
        "sources"
      ],
      "properties": {
        "ownership_id": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentRef"
          }
        }
      }
    },
    "lockedArtifact": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ownership_id",
            "target",
            "adapter",
            "path",
            "sources",
            "content_digest",
            "portable_mode"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "ownership_id": {
              "$ref": "#/$defs/stableId"
            },
            "target": {
              "$ref": "#/$defs/stableId"
            },
            "adapter": {
              "$ref": "#/$defs/stableId"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/componentRef"
              }
            },
            "content_digest": {
              "$ref": "#/$defs/sha256"
            },
            "portable_mode": {
              "enum": [
                "regular",
                "executable"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ownership_id",
            "target",
            "adapter",
            "path",
            "sources",
            "content_digest",
            "link_target"
          ],
          "properties": {
            "kind": { "const": "symlink" },
            "ownership_id": { "$ref": "#/$defs/stableId" },
            "target": { "$ref": "#/$defs/stableId" },
            "adapter": { "$ref": "#/$defs/stableId" },
            "path": { "$ref": "#/$defs/relativePath" },
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/componentRef" }
            },
            "content_digest": { "$ref": "#/$defs/sha256" },
            "link_target": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*\\\\)[A-Za-z0-9._/-]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ownership_id",
            "target",
            "adapter",
            "path",
            "section_id",
            "placement",
            "marker_style",
            "sources",
            "content_digest"
          ],
          "properties": {
            "kind": {
              "const": "managed-section"
            },
            "ownership_id": {
              "$ref": "#/$defs/stableId"
            },
            "target": {
              "$ref": "#/$defs/stableId"
            },
            "adapter": {
              "$ref": "#/$defs/stableId"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "section_id": {
              "$ref": "#/$defs/stableId"
            },
            "placement": {
              "enum": [
                "whole-file",
                "append"
              ]
            },
            "marker_style": {
              "enum": [
                "markdown",
                "hash"
              ]
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/componentRef"
              }
            },
            "content_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ownership_id",
            "target",
            "adapter",
            "path",
            "pointer",
            "sources",
            "content_digest"
          ],
          "properties": {
            "kind": {
              "const": "json-member"
            },
            "ownership_id": {
              "$ref": "#/$defs/stableId"
            },
            "target": {
              "$ref": "#/$defs/stableId"
            },
            "adapter": {
              "$ref": "#/$defs/stableId"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "pointer": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/componentRef"
              }
            },
            "content_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "lockedGitConfigEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "effect_id",
        "sources",
        "key",
        "expected_value"
      ],
      "properties": {
        "kind": {
          "const": "git-config"
        },
        "effect_id": {
          "$ref": "#/$defs/stableId"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/componentRef"
          }
        },
        "key": {
          "const": "core.hooksPath"
        },
        "expected_value": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "desired_digest",
        "catalog",
        "targets",
        "components",
        "directories",
        "artifacts",
        "local_effects"
      ],
      "properties": {
        "schema": {
          "const": "railguard/lock/v1"
        },
        "desired_digest": {
          "$ref": "#/$defs/sha256"
        },
        "catalog": {
          "$ref": "#/$defs/catalogIdentity"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedTarget"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedComponent"
          }
        },
        "directories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedDirectory"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedArtifact"
          }
        },
        "local_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lockedGitConfigEffect"
          }
        }
      }
    },
    "observedUnitState": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "absent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "digest"
          ],
          "properties": {
            "kind": {
              "const": "present"
            },
            "digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ]
    },
    "pathPrecondition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "observed"
          ],
          "properties": {
            "kind": {
              "const": "file"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "observed": {
              "$ref": "#/$defs/observedUnitState"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "section_id",
            "container_digest",
            "content_digest"
          ],
          "properties": {
            "kind": {
              "const": "managed-section"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            },
            "section_id": {
              "$ref": "#/$defs/stableId"
            },
            "container_digest": {
              "$ref": "#/$defs/nullableDigest"
            },
            "content_digest": {
              "$ref": "#/$defs/nullableDigest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "key",
            "value_digest"
          ],
          "properties": {
            "kind": {
              "const": "git-config"
            },
            "key": {
              "const": "core.hooksPath"
            },
            "value_digest": {
              "$ref": "#/$defs/nullableDigest"
            }
          }
        }
      ]
    },
    "planBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_fingerprint",
        "desired_before_digest",
        "desired_after_digest",
        "lock_before_digest",
        "catalog_digest"
      ],
      "properties": {
        "repository_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "desired_before_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "desired_after_digest": {
          "$ref": "#/$defs/sha256"
        },
        "lock_before_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "catalog_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "artifactChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit_id",
        "owner",
        "action",
        "target",
        "before",
        "after"
      ],
      "properties": {
        "unit_id": {
          "$ref": "#/$defs/stableId"
        },
        "owner": {
          "$ref": "#/$defs/stableId"
        },
        "action": {
          "enum": [
            "create",
            "replace",
            "remove"
          ]
        },
        "target": {
          "$ref": "#/$defs/artifactPointer"
        },
        "before": {
          "$ref": "#/$defs/observedUnitState"
        },
        "after": {
          "$ref": "#/$defs/observedUnitState"
        }
      }
    },
    "gitConfigChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "unit_id",
        "action",
        "key",
        "before_value_digest",
        "after_value"
      ],
      "properties": {
        "kind": {
          "const": "git-config"
        },
        "unit_id": {
          "$ref": "#/$defs/stableId"
        },
        "action": {
          "enum": [
            "set",
            "restore"
          ]
        },
        "key": {
          "const": "core.hooksPath"
        },
        "before_value_digest": {
          "$ref": "#/$defs/nullableDigest"
        },
        "after_value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "verificationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stableId"
        },
        "kind": {
          "enum": [
            "materialization",
            "certification"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "plan_id",
        "mode",
        "basis",
        "preconditions",
        "changes",
        "local_effects",
        "verification"
      ],
      "properties": {
        "schema": {
          "const": "railguard/plan/v1"
        },
        "plan_id": {
          "$ref": "#/$defs/sha256"
        },
        "mode": {
          "enum": [
            "reconcile",
            "repair",
            "remove"
          ]
        },
        "basis": {
          "$ref": "#/$defs/planBasis"
        },
        "preconditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathPrecondition"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactChange"
          }
        },
        "local_effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gitConfigChange"
          }
        },
        "verification": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/verificationRequirement"
          }
        }
      }
    }
  }
}
