{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:ai-harness:schema:release-manifest:v1",
  "title": "AI Harness release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "channel", "source", "release", "authentication", "content"],
  "properties": {
    "schema": { "const": "ai-harness/release-manifest/v1" },
    "channel": { "$ref": "#/$defs/id" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "input_digest"],
      "properties": {
        "commit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tree": { "type": "string", "minLength": 1, "maxLength": 128 },
        "input_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "runtime", "artifact", "sbom", "notices", "notes"],
      "properties": {
        "name": { "const": "@example/ai-harness" },
        "version": { "$ref": "#/$defs/semver" },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "pnpm"],
          "properties": {
            "node": { "const": ">=24.19.0 <25.0.0" },
            "pnpm": { "const": ">=11.21.0 <12.0.0" }
          }
        },
        "artifact": { "$ref": "#/$defs/file" },
        "sbom": { "$ref": "#/$defs/file" },
        "notices": { "$ref": "#/$defs/file" },
        "notes": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest_authentication"],
      "properties": {
        "kind": { "const": "external-https-channel" },
        "manifest_authentication": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest"],
      "properties": {
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
              "maxLength": 200
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "maxLength": 200
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    }
  }
}
