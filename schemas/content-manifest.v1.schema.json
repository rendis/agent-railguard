{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:example:ai-harness:schema:content-manifest:v1",
  "title": "AI Harness content manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "source", "files", "authentication"],
  "properties": {
    "schema": { "const": "ai-harness/content-manifest/v1" },
    "revision": { "$ref": "#/$defs/semver" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "input_digest"],
      "properties": {
        "commit": { "type": "string", "minLength": 1, "maxLength": 128 },
        "tree": { "type": "string", "minLength": 1, "maxLength": 128 },
        "input_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/file" }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "manifest_authentication"],
      "properties": {
        "kind": { "const": "external-https-channel" },
        "manifest_authentication": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "mode", "sha256", "size"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "mode": { "enum": ["100644", "100755"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        }
      }
    }
  }
}
