{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Railguard catalog authoring v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "catalog"],
  "properties": {
    "schema": {
      "const": "railguard/v1"
    },
    "version": {
      "$ref": "#/$defs/semver"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skills",
        "mcps",
        "verification-profiles",
        "git-gates",
        "instruction-fragments",
        "packs",
        "agents"
      ],
      "properties": {
        "skills": {
          "$ref": "#/$defs/skills"
        },
        "mcps": {
          "$ref": "#/$defs/mcps"
        },
        "verification-profiles": {
          "$ref": "#/$defs/verificationProfiles"
        },
        "git-gates": {
          "$ref": "#/$defs/gitGates"
        },
        "agent-hooks": {
          "$ref": "#/$defs/agentHooks"
        },
        "instruction-fragments": {
          "$ref": "#/$defs/instructionFragments"
        },
        "packs": {
          "$ref": "#/$defs/packs"
        },
        "agents": {
          "$ref": "#/$defs/agents"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "inputId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "toolId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "languageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "componentRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*:[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "details": {
      "type": "string",
      "minLength": 40,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "reason"],
      "properties": {
        "kind": {
          "enum": ["requires", "recommends", "composes", "conflicts"]
        },
        "target": {
          "$ref": "#/$defs/componentRef"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "details", "source"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "details": {
          "$ref": "#/$defs/details"
        },
        "source": {
          "$ref": "#/$defs/relativePath"
        },
        "applies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["languages"],
          "properties": {
            "languages": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/languageId"
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/skill"
      }
    },
    "verificationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "details", "executables", "checks"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        },
        "details": { "$ref": "#/$defs/details" },
        "applies": { "$ref": "#/$defs/optionalApplies" },
        "executables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/inputId"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "default", "item_pattern"],
            "properties": {
              "type": {
                "const": "string-list"
              },
              "default": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "item_pattern": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "stage"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "kind": { "$ref": "#/$defs/id" },
              "stage": { "enum": ["check", "verify"] },
              "params": {
                "type": "object",
                "propertyNames": { "$ref": "#/$defs/inputId" },
                "additionalProperties": {
                  "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
                }
              }
            }
          }
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "verificationProfiles": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/verificationProfile"
      }
    },
    "gitGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "details", "event", "operation", "relations"],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        },
        "details": { "$ref": "#/$defs/details" },
        "event": {
          "enum": ["pre-commit", "pre-push"]
        },
        "operation": {
          "enum": ["check", "verify"]
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "gitGates": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/gitGate"
      }
    },
    "agentHook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "details", "event"],
      "oneOf": [
        {
          "properties": { "event": { "const": "stop" }, "operation": { "enum": ["check", "verify"] } },
          "required": ["operation"]
        },
        {
          "properties": { "event": { "const": "pre-action" }, "operation": false }
        }
      ],
      "properties": {
        "version": {
          "$ref": "#/$defs/semver"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        },
        "details": { "$ref": "#/$defs/details" },
        "event": {
          "enum": ["stop", "pre-action"]
        },
        "operation": {
          "enum": ["check", "verify"]
        },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      }
    },
    "agentHooks": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/id"
      },
      "additionalProperties": {
        "$ref": "#/$defs/agentHook"
      }
    },
    "includeRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target", "reason"],
      "properties": {
        "kind": {
          "const": "includes"
        },
        "target": {
          "$ref": "#/$defs/componentRef"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        }
      }
    },
    "optionalApplies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["languages"],
      "properties": {
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/languageId"
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "description",
        "details",
        "trust",
        "connection",
        "tools",
        "network",
        "auth"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        },
        "details": { "$ref": "#/$defs/details" },
        "trust": { "const": "third-party-network" },
        "connection": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "command", "args"],
              "properties": {
                "type": { "const": "stdio" },
                "command": { "$ref": "#/$defs/id" },
                "args": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "url"],
              "properties": {
                "type": { "const": "remote-http" },
                "url": {
                  "type": "string",
                  "pattern": "^https://[^\\s]+$"
                }
              }
            }
          ]
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/toolId" }
        },
        "network": { "const": "runtime-required" },
        "auth": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "none" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "activation"],
              "properties": {
                "type": { "const": "oauth" },
                "activation": { "const": "harness-native" }
              }
            }
          ]
        },
        "applies": { "$ref": "#/$defs/optionalApplies" },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "connection": {
                "type": "object",
                "properties": { "type": { "const": "stdio" } }
              }
            }
          },
          "then": {
            "properties": {
              "auth": {
                "type": "object",
                "properties": { "type": { "const": "none" } }
              }
            }
          },
          "else": {
            "properties": {
              "auth": {
                "type": "object",
                "properties": { "type": { "const": "oauth" } }
              }
            }
          }
        }
      ]
    },
    "mcps": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/mcp" }
    },
    "instructionContent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "group"],
      "properties": {
        "kind": { "const": "catalog-index" },
        "group": { "enum": ["skills", "mcps", "agents", "automation", "quality"] }
      }
    },
    "instructionFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "details", "section", "content"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        },
        "details": { "$ref": "#/$defs/details" },
        "section": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "content": { "$ref": "#/$defs/instructionContent" },
        "applies": { "$ref": "#/$defs/optionalApplies" },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    },
    "instructionFragments": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/instructionFragment" }
    },
    "pack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "details", "relations"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        },
        "details": { "$ref": "#/$defs/details" },
        "applies": { "$ref": "#/$defs/optionalApplies" },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/includeRelation" }
        }
      }
    },
    "packs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/pack" }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "description", "details", "prompt"],
      "properties": {
        "version": { "$ref": "#/$defs/semver" },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?!\\s)(?:[^\\r\\n]*\\S)?$"
        },
        "details": { "$ref": "#/$defs/details" },
        "prompt": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "applies": { "$ref": "#/$defs/optionalApplies" },
        "relations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relation" }
        }
      }
    },
    "agents": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/id" },
      "additionalProperties": { "$ref": "#/$defs/agent" }
    }
  }
}
