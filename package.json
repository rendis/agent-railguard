{
  "name": "agent-railguard",
  "version": "0.1.7",
  "private": true,
  "description": "Configure a repository so coding agents work inside deterministic quality guardrails",
  "repository": "github:rendis/agent-railguard",
  "type": "module",
  "bin": {
    "railguard": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.19.0 <25.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "check": "pnpm run typecheck && pnpm run test:coverage && pnpm run check:skills && pnpm run check:boundaries && pnpm run build && pnpm run check:bundle",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check:bundle": "node scripts/verification/smoke-bundle.mjs",
    "check:skills": "node scripts/verification/test-skill-scripts.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:binaries": "node scripts/build-binaries.mjs"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "ajv": "8.20.0",
    "commander": "15.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "dependency-cruiser": "18.1.1",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
